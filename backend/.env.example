# Copy this file to .env and fill in what you need.

# AI assistant: gemini | anthropic | ollama   (leave empty = offline mode, shows top passages)
LLM_PROVIDER=gemini
LLM_API_KEY=paste-your-key-here
# Optional: override the model name if the default is not available on your account
# LLM_MODEL=gemini-2.5-flash

# Admin dashboard PIN
ADMIN_PIN=1234

# Must match SENSOR_TOKEN in the ESP8266 sketch (leave empty to disable the check)
SENSOR_TOKEN=sih-demo-token

# ESP32-CAM address (you can also set it from the admin page)
# ESP32CAM_URL=http://192.168.43.50

# Windows only, if tesseract is not on PATH
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Whisper speech model: tiny | base | small  (small = better Hindi/Marathi, slower)
WHISPER_MODEL=small

# Set this if you expose the server through an HTTPS tunnel (needed for iPad microphone)
# PUBLIC_BASE_URL=https://your-tunnel.trycloudflare.com
